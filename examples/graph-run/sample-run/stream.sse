data: {"node":"rust-impl","run":"f871bc2e36bff1a5addfa7e742c170c0","text":"/// Sorts a `Vec<i64>` in ascending order using a stable merge sort.\npub fn merge_sort(mut v: Vec<i64>) -> Vec<i64> {\n    let len = v.len();\n    if len <= 1 {\n        return v;\n    }\n    let mid = len / 2;\n    let right = v.split_off(mid);\n    let left = merge_sort(v);\n    let right = merge_sort(right);\n\n    let mut merged = Vec::with_capacity(len);\n    let mut i = 0;\n    let mut j = 0;\n    while i < left.len() && j < right.len() {\n        if left[i] <= right[j] {\n            merged.push(left[i]);\n            i += 1;\n        } else {\n            merged.push(right[j]);\n            j += 1;\n        }\n    }\n    merged.extend_from_slice(&left[i..]);\n    merged.extend_from_slice(&right[j..]);\n    merged\n}"}

