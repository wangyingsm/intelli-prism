data: {"node":"go-impl","run":"f871bc2e36bff1a5addfa7e742c170c0","text":"package main\n\n// MergeSort sorts numbers in ascending order using a stable top-down merge sort.\n// It allocates a single auxiliary buffer of the same length and returns a new slice.\nfunc MergeSort(numbers []int64) []int64 {\n\tn := len(numbers)\n\tif n < 2 {\n\t\treturn append([]int64(nil), numbers...)\n\t}\n\tsrc := append([]int64(nil), numbers...)\n\tdst := make([]int64, n)\n\twidth := 1\n\tfor width < n {\n\t\tfor lo := 0; lo < n; lo += 2 * width {\n\t\t\tmid := lo + width\n\t\t\thi := lo + 2*width\n\t\t\tif mid > n {\n\t\t\t\tmid = n\n\t\t\t}\n\t\t\tif hi > n {\n\t\t\t\thi = n\n\t\t\t}\n\t\t\ti, j, k := lo, mid, lo\n\t\t\tfor i < mid && j < hi {\n\t\t\t\tif src[i] <= src[j] {\n\t\t\t\t\tdst[k] = src[i]\n\t\t\t\t\ti++\n\t\t\t\t} else {\n\t\t\t\t\tdst[k] = src[j]\n\t\t\t\t\tj++\n\t\t\t\t}\n\t\t\t\tk++\n\t\t\t}\n\t\t\tfor i < mid {\n\t\t\t\tdst[k] = src[i]\n\t\t\t\ti++\n\t\t\t\tk++\n\t\t\t}\n\t\t\tfor j < hi {\n\t\t\t\tdst[k] = src[j]\n\t\t\t\tj++\n\t\t\t\tk++\n\t\t\t}\n\t\t}\n\t\tsrc, dst = dst, src\n\t\twidth *= 2\n\t}\n\treturn src\n}"}

