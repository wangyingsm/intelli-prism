data: {"node":"rust-bench","run":"f871bc2e36bff1a5addfa7e742c170c0","text":"```rust\n// benches/merge_sort_bench.rs\n//\n// Add to Cargo.toml:\n//   [dev-dependencies]\n//   criterion = { version = \"0.5\", features = [\"html_reports\"] }\n//\n//   [[bench]]\n//   name = \"merge_sort_bench\"\n//   harness = false\n\nuse criterion::{black_box, criterion_group, criterion_main, Criterion, Throughput};\n\npub fn merge_sort(mut v: Vec<i64>) -> Vec<i64> {\n    let len = v.len();\n    if len <= 1 {\n        return v;\n    }\n    let mid = len / 2;\n    let right = v.split_off(mid);\n    let left = merge_sort(v);\n    let right = merge_sort(right);\n\n    let mut merged = Vec::with_capacity(len);\n    let mut i = 0;\n    let mut j = 0;\n    while i < left.len() && j < right.len() {\n        if left[i] <= right[j] {\n            merged.push(left[i]);\n            i += 1;\n        } else {\n            merged.push(right[j]);\n            j += 1;\n        }\n    }\n    merged.extend_from_slice(&left[i..]);\n    merged.extend_from_slice(&right[j..]);\n    merged\n}\n\n/// Small deterministic xorshift PRNG so the input is reproducible without extra deps.\nstruct Rng(u64);\n\nimpl Rng {\n    fn new(seed: u64) -> Self {\n        Rng(seed.max(1))\n    }\n    fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x << 13;\n        x ^= x >> 7;\n        x ^= x << 17;\n        self.0 = x;\n        x\n    }\n    fn next_i64(&mut self) -> i64 {\n        self.next_u64() as i64\n    }\n}\n\nfn bench_merge_sort(c: &mut Criterion) {\n    const N: usize = 10_000;\n\n    let mut rng = Rng::new(0xDEADBEEFCAFEBABE);\n    let data: Vec<i64> = (0..N).map(|_| rng.next_i64()).collect();\n\n    let mut group = c.benchmark_group(\"merge_sort\");\n    group.throughput(Throughput::Elements(N as u64));\n\n    group.bench_function(\"random_i64_10k\", |b| {\n        b.iter(|| {\n            // black_box the input clone so LLVM cannot hoist/eliminate the sort.\n            let input = black_box(data.clone());\n            black_box(merge_sort(input));\n        });\n    });\n\n    group.finish();\n}\n\ncriterion_group!(benches, bench_merge_sort);\ncriterion_main!(benches);\n```\n\ncargo bench --bench merge_sort_bench"}

