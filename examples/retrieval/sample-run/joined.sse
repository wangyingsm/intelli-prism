data: {"failed":false,"id":"call_01_QK2850LNIfsdkFQpHh5P2325","node":"look","run":"dc44bb83f10b184aebb86efcca938c9c","text":"{\"id\":\"257\",\"found\":{\"edge\":{\"properties\":{},\"type\":\"MEASURED_BY\"},\"node\":{\"key\":\"reefer-telemetry\",\"labels\":[\"Page\"],\"properties\":{\"embedding\":\"$vector(384 dims, omitted)\",\"status\":\"current\",\"team\":\"reefer\",\"text\":\"Every reefer reports its set point, its return air temperature and its power state once a minute while it is powered. A reading outside the set band for more than twenty consecutive minutes is logged as an excursion, with the first and last minute of it. A container that stops reporting is not an excursion and is handled as a telemetry fault.\",\"title\":\"What the reefer telemetry feed reports\"}}}}\n{\"id\":\"129\",\"found\":{\"edge\":{\"properties\":{},\"type\":\"SUPERSEDED_BY\"},\"node\":{\"key\":\"cold-chain-r6\",\"labels\":[\"Page\"],\"properties\":{\"embedding\":\"$vector(384 dims, omitted)\",\"status\":\"superseded\",\"team\":\"reefer\",\"text\":\"Hold the shipment at whichever hub it is in and do not move it. Notify the consignee within four hours of the excursion being logged and raise form CX-11 with the reading attached. Do not re-ice before the consignee has answered, because re-icing destroys the evidence a claim is assessed on.\",\"title\":\"Cold-chain excursion response, revision 6\"}}}}"}

