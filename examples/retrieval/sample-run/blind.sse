event: tool_result
data: {"failed":false,"id":"call_00_jdxMc6VWsO2QApvpgJCy6552","node":"look","run":"f91ea4dc2dfe7820cd3523642391e2ce","text":"{\"id\":\"5\",\"score\":0.883912,\"found\":{\"key\":\"reefer-telemetry\",\"status\":\"current\",\"team\":\"reefer\",\"text\":\"Every reefer reports its set point, its return air temperature and its power state once a minute while it is powered. A reading outside the set band for more than twenty consecutive minutes is logged as an excursion, with the first and last minute of it. A container that stops reporting is not an excursion and is handled as a telemetry fault.\",\"title\":\"What the reefer telemetry feed reports\"}}\n{\"id\":\"3\",\"score\":0.8757266,\"found\":{\"key\":\"cold-chain-r6\",\"status\":\"superseded\",\"team\":\"reefer\",\"text\":\"Hold the shipment at whichever hub it is in and do not move it. Notify the consignee within four hours of the excursion being logged and raise form CX-11 with the reading attached. Do not re-ice before the consignee has answered, because re-icing destroys the evidence a claim is assessed on.\",\"title\":\"Cold-chain excursion response, revision 6\"}}"}

